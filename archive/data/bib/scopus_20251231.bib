	author = {Jayalath, Madushan Madhava and Ratnayake, R. M.Chandima and Perera, H. Niles and Thibbotuwawa, Amila},
	title = {Digitalizing traditional agri-food supply chains in developing economies: A pathway to regulated sustainable governance},
	year = {2025},
