	author = {Filho, Marco Souza and Albertin, Alberto Luiz},
	title = {Digital transformation path: How dynamic capabilities further strategic use of information technology benefits through alliances; Jornada da transformação digital: Como as capacidades dinâmicas apoiam o uso estratégico dos benefícios da tecnologia da informação por meio de alianças},
