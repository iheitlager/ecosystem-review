	keywords = {adult; health care personnel; human; middle aged; national health service; questionnaire; telemedicine; United Kingdom; Adult; Health Personnel; Humans; Middle Aged; State Medicine; Surveys and Questionnaires; Telemedicine},
	type = {Article},
