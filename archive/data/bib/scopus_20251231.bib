@ARTICLE{Daoud2025,
	author = {Daoud, Ahmed Osama and Lal, Ratan and Gouda Mohamed, Ahmed and Mohamed, Mayar and Wefki, Hossam},
	title = {An implementation framework for blockchain and smart contracts adoption in the egyptian construction sector},
	year = {2025},
