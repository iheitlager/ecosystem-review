@ARTICLE{García-López20251323,
	author = {García-López, Ana María and Galindo-Pérez-de-Azpillaga, Luis and Foronda-Robles, Concepción},
	title = {The Flow of Digital Transition: The Challenges of Technological Solutions for Hotels},
	year = {2025},
	journal = {Social Indicators Research},
	volume = {178},
