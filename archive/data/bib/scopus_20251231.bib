@ARTICLE{Agarwal2025,
	author = {Agarwal, Ruchi and Kallapur, Sanjay and Dwivedi, Sanjiv},
	title = {Leveraging digital technologies to control fraud in a resource-constrained institutional environment: a longitudinal case study},
	year = {2025},
	journal = {Journal of Accounting and Organizational Change},
