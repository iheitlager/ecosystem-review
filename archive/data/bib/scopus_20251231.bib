@ARTICLE{Beyer2025,
	author = {Beyer, Florian and Brandt, Patric and Schmidt, Michael and Konig, Simon and Stahl, Ulrike and Baumann, Peter and Golla, Burkhard and Gerighausen, Heike and Möller, Markus},
	title = {Big Geodata and Spatial Data Infrastructures: a Perspective of a German Authority},
	year = {2025},
	journal = {PFG - Journal of Photogrammetry, Remote Sensing and Geoinformation Science},
