}

@ARTICLE{He2025,
	author = {He, Zhengxia and Tu, Hongnan and Wang, Jianming and Cao, Changshuai},
	title = {The impact of artificial intelligence on corporate environmental behavior: the mechanism of internal control and supply chain integration},
	year = {2025},
	journal = {Environment, Development and Sustainability},
	pages = {},
	doi = {10.1007/s10668-025-06739-7},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105016713870&doi=10.1007%2Fs10668-025-06739-7&partnerID=40&md5=4a8cedc16278734d55c6c62a0300ee12},
	abstract = {While artificial intelligence (AI) is transforming corporate operations, its organizational pathways to improve environmental performance remain underexplored. This study addresses this critical gap by examining how AI enhances corporate environmental behavior (CEB) through internal governance mechanisms rather than just technical features. Grounded in the Resource-Based View (RBV), we propose that AI serves as a strategic resource whose environmental value is realized through two complementary governance pathways: enhanced internal control systems and strengthened supply chain integration. Using panel data from 968 Chinese listed firms (2012–2022) and a two-way fixed effects model with robustness checks, we examine how AI enhances CEB through internal governance mechanisms. We reveal three key findings: (Ayoub et al. 2017) AI adoption increases CEB by 38.29% (p< 0.01), measured through green patent applications; (Antoncic 2020)this effect is positively moderated by both supply chain integration (including customer and supplier integration) and internal control quality; and (Ashraf 2024) the impacts are most pronounced for state-owned enterprises (SOEs), large firms, and energy-intensive industries.We extend RBV theory by revealing AI’s environmental value as a VRIN(valuable, rare, inimitable, non-substitutable) resource depends on organizational governance, bridging digital transformation and environmental governance research. The results demonstrate that governance-enhanced AI delivers the strongest environmental benefits, particularly in state-owned and energy-intensive firms, suggesting policymakers should target subsidies at AI applications that strengthen internal governance mechanisms while firms align AI investments with governance capacity-building. The study offers the first empirical evidence that AI’s environmental returns depend critically on internal governance quality, challenging prevailing technological-deterministic views in sustainable operations research. © The Author(s), under exclusive licence to Springer Nature B.V. 2025.},
	author_keywords = {Artificial intelligence; Corporate environmental behavior; Internal control; Supply chain integration; The resource-based view},
	type = {Article},
	publication_stage = {aip},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Burtscher20251,
	author = {Burtscher, Janina and Leipziger, Martin and Kanbach, Dominik K. and Kraus, Sascha},
	title = {Pathways to twin transformation in SMEs: the role of innovation ecosystems},
	year = {2025},
	journal = {European Journal of Innovation Management},
	pages = {1 - 26},
	doi = {10.1108/EJIM-11-2024-1382},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105016497983&doi=10.1108%2FEJIM-11-2024-1382&partnerID=40&md5=730b452d57294e31ba9a79c827a1fc8b},
	abstract = {Purpose – This study examines the key factors influencing twin transformation (TT) in small and medium-sized enterprises (SMEs) in Austria and Germany. By exploring insights from SME managers, founders, and representatives of innovation ecosystems (IEs), it highlights how IEs help SMEs navigate barriers and leverage enablers in their transformation journey. Design/methodology/approach – An exploratory research approach is utilized, drawing on 62 semi-structured interviews. An inductive approach for concept development was applied to structure the qualitative data, followed by a fuzzy-set qualitative comparative analysis (fsQCA) to identify transformation pathways. Findings – The results reveal different pathways to TT, shaped by varying enablers and barriers. Corporate culture and internal alignment emerge as fundamental enablers. In addition, the findings show that IEs mitigate barriers such as financial constraints and knowledge gaps while amplifying enablers like strategic partnerships and technological readiness. Practical implications – The findings offer actionable insights for policymakers, IEs, and SMEs to advance TT by addressing common barriers and activating enablers, including support from public-private partnerships, funding programs, and digital innovation hubs. Originality/value – This study contributes to the growing discourse on TT by empirically mapping the enablers and barriers SMEs encounter. It underscores the critical role of IEs in supporting SMEs and provides a nuanced perspective on how ecosystems facilitate the integration of digitalization and sustainability. © 2025 Emerald Publishing Limited},
	author_keywords = {Barriers; Digital innovation ecosystem; Digital transformation; Enablers; fsQCA; Innovation ecosystem; Small and medium enterprises; Small business; Sustainability; Twin transformation; Twin transition},
