@ARTICLE{Shovkovyy2024,
	author = {Shovkovyy, Oleg},
	title = {Defining Electronic Bureaucracy and Bureaucratism},
	year = {2024},
	journal = {Suranaree Journal of Social Science},
	volume = {18},
