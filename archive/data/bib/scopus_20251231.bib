}

@ARTICLE{Hefny2023729,
	author = {Hefny, Mohamed Hamed and Helmy, Yehia Mostafa K. and Abdelsalam, Mohamed},
	title = {Open Banking API Framework to Improve the Online Transaction between Local Banks in Egypt Using Blockchain Technology},
	year = {2023},
	journal = {Journal of Advances in Information Technology},
	volume = {14},
	number = {4},
	pages = {729 - 740},
	doi = {10.12720/jait.14.4.729-740},
