@ARTICLE{Raja20221518,
	author = {Raja, Moonika and Uhrenfeldt, Lisbeth and Galvin, Kathleen T. and Kymre, Ingjerd Gare},
	title = {Older adults` sense of dignity in digitally led healthcare},
