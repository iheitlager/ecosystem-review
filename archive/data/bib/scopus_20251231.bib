@ARTICLE{Shava2025,
	author = {Shava, Elvin and Muringa, Tigere Paidamoyo and Oladejo, Olufemi Michael},
	title = {“Spare the Rod and Spoil the Child”: navigating consequence management in local government transformation in South Africa},
	year = {2025},
	journal = {Frontiers in Political Science},
	volume = {7},
	pages = {},
	doi = {10.3389/fpos.2025.1579256},
