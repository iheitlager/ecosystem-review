@ARTICLE{Zhang2024,
	author = {Zhang, Xuming and Wang, Ping and Peng, Ling},
	title = {Developing a Competency Model for Human Resource Directors (HRDs) in Exponential Organizations Undergoing Digital Transformation},
	year = {2024},
	journal = {Sustainability (Switzerland)},
