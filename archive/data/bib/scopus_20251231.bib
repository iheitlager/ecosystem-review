	author = {Nguyen, Thi Bach Tuyet and Doan, Thanhnga and Ta, Trangtrang and Tran, Hai Yen and Nguyen, Dieu Anh and Pham, Minh Anh and Nguyen, Thuy Huong and Nguyen, Phuong Thao},
	title = {FACTORS AFFECTING THE INTENTION OF ADOPTING CLOUD-BASED ACCOUNTING STRATEGY: THE CASE OF MICRO, SMALL, AND MEDIUM-SIZED ENTERPRISES},
	year = {2025},
