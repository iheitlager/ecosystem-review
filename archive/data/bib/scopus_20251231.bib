@ARTICLE{Karmakar202440,
	author = {Karmakar, Uttam and Sarma, Amiya},
	title = {Unlocking Trade Potential: A Stochastic Frontier Gravity Model Analysis of India-Africa Information and Communication Technology (ICT) Goods Trade},
