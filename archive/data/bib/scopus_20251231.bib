@ARTICLE{Canfell2022,
	author = {Canfell, Oliver J. and Kodiyattu, Zack and Eakin, Elizabeth G. and Burton-Jones, Andrew and Wong, Ides Y. and Macaulay, Caroline and Sullivan, Clair M.},
	title = {Real-world data for precision public health of noncommunicable diseases: a scoping review},
	year = {2022},
	journal = {BMC Public Health},
	volume = {22},
