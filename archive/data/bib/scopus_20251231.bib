@ARTICLE{Manfreda2019948,
	author = {Manfreda, Anton and Indihar-Štemberger, Mojca},
	title = {Establishing a partnership between top and IT managers: A necessity in an era of digital transformation},
	year = {2019},
	journal = {Information Technology and People},
	volume = {32},
	number = {4},
	pages = {948 - 972},
