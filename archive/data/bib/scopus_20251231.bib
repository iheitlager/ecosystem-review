@ARTICLE{Zhao2024,
	author = {Zhao, Jun and Liu, Xiaoyan},
	title = {ICT, Supply Chain Digital Integration Capability, and Firm Financial Performance: The Antagonistic Effects of Perceived Government Support and Cognitive Constraints on Digital Transformation},
	year = {2024},
	journal = {SAGE Open},
