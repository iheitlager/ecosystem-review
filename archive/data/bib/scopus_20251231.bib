	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105002050678&doi=10.1080%2F00036846.2025.2482236&partnerID=40&md5=2e96f2ce10722d40ab67a4fc6c711058},
	abstract = {Enabling greening through digitalization has become an effective way for enterprises to achieve green transformation. Previous studies have not examined whether the digital transformation of businesses contributes to green technology innovation among upstream and downstream enterprises from a supply chain perspective. To fill this gap, this study constructs a supplier–customer–year supply chain relationship sample using data on Chinese listed companies from 2009 to 2020, and applies a two-way fixed-effects model to examine the impact of downstream customers’ digital transformation on upstream suppliers’ green technology innovation. Findings show that customer-driven digital transformation significantly increases suppliers’ green technological innovation, through the action channels of the forcing effect of green transformation, cohort effect of digital transformation, and spillover effect of green technological innovation. Heterogeneity analysis reveals that the effect of customer digital transformation on suppliers’ green technological innovation differs significantly based on different supplier and customer characteristics. Further analysis indicates that the synergy between digitalization and greening created by customer digital transformation can also play a crucial role in enhancing suppliers’ environmental and social governance performance. The findings have significant policy implications for the synergistic development of digitalization and greening of the entire supply chain, with the opportunity to foster sustainable socioeconomic development. © 2025 Informa UK Limited, trading as Taylor & Francis Group.},
	author_keywords = {digital transformation; green technology innovation; peer effect; spillover effect; Supply chain},
