@ARTICLE{Zhang2025,
	author = {Zhang, Hongjie and He, Feng and Wan, Paijie and Zhang, Yao and Zhu, Yingming},
	title = {The digital path to green: Exploring the impact of supply chain digital transformation on corporate green investments},
	year = {2025},
	journal = {Journal of Cleaner Production},
	volume = {526},
	pages = {},
	doi = {10.1016/j.jclepro.2025.146656},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105016314248&doi=10.1016%2Fj.jclepro.2025.146656&partnerID=40&md5=e179a8f0ac3080f1c82be0cfda13fb96},
	abstract = {This study examines the impact of supply chain digital transformation on corporate green investment, employing text analysis and machine learning methods to reconstruct green investment. Using data from Chinese listed companies (2010–2022), the analysis reveals that supply chain digital transformation significantly enhances corporate green investment. The robustness of this relationship is verified through multiple approaches, including parallel trend tests, placebo tests, and small sample bias analysis. The effect primarily manifests through improved resource integration and accumulation among upstream suppliers. Notably, corporate positions such as Chief Information Officers and investor environmental inquiries further amplify this positive influence. By systematically developing a resource endowment framework that transcends traditional dyadic supply chain research paradigms, this investigation provides more direct evidence for the literature on digitally enabled environmental outcomes. © 2025 Elsevier Ltd},
	author_keywords = {Corporate Green investment; Digital transformation; Resource endowment; Supply chain},
