@ARTICLE{Guttieres2019,
	author = {Guttieres, Donovan and Stewart, Shannon and Wolfrum, Jacqueline M. and Springs, Stacy L.},
	title = {Cyberbiosecurity in Advanced Manufacturing Models},
	year = {2019},
	journal = {Frontiers in Bioengineering and Biotechnology},
	volume = {7},
