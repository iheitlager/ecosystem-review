@ARTICLE{Kamalaldin2020306,
	author = {Kamalaldin, Anmar and Linde, Lina and Sjödin, David Rönnberg and Parida, Vinit},
	title = {Transforming provider-customer relationships in digital servitization: A relational view on digitalization},
