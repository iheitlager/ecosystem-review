@ARTICLE{Perdana2025,
	author = {Perdana, Arif and Chu, Mui Kim},
	title = {Environmental sustainability meets digital transformation: Dilemmas and new directions},
	year = {2025},
	journal = {Journal of Information Technology Teaching Cases},
	pages = {},
