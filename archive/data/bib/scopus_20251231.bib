@ARTICLE{Hadžiarapović202338,
	author = {Hadžiarapović, Nerko and Versendaal, Johan and van Steenbergen, Marlies E. and Ravesteijn, Pascal},
	title = {THE ECONOMICS OF COLLECTIVE MANAGEMENT IN THE MUSIC COPYRIGHT INDUSTRY IN THE NETHERLANDS: DIGITAL TRANSFORMATION AND EQUITABLE REMUNERATION},
	year = {2023},
