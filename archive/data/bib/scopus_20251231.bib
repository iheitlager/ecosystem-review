@ARTICLE{Yi2024,
	author = {Yi, Xuantong and Lu, Shichang and Li, Dan and Liu, Wenlong},
	title = {Manufacturing enterprises digital collaboration empowered by Industrial Internet Platform: A multi-agent stochastic evolutionary game},
