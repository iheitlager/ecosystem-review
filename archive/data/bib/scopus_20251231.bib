@ARTICLE{Vaskelainen2022231,
	author = {Vaskelainen, Taneli and Münzel, Karla and Boon, Wouter P.C. and Frenken, Koen},
	title = {Servitisation on consumer markets: entry and strategy in Dutch private lease markets},
	year = {2022},
	journal = {Innovation: Organization and Management},
	volume = {24},
