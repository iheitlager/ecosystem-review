@ARTICLE{Spreitzenbarth2024,
	author = {Spreitzenbarth, Jan and Bode, Christoph and Stuckenschmidt, Heiner},
	title = {Artificial intelligence and machine learning in purchasing and supply management: A mixed-methods review of the state-of-the-art in literature and practice},
	year = {2024},
	journal = {Journal of Purchasing and Supply Management},
	volume = {30},
