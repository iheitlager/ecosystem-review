@ARTICLE{Mohaidin2025217,
	author = {Mohaidin, Nur Jannah and Aman, Aini Binti and Ilias, Azleen},
	title = {Digital Transformation in Financial Reporting: Institutional Pressures Shaping eXtensible Business Reporting Language Implementation in Malaysia},
