	author = {Moldt, Julia Astrid and Festl-Wietek, Teresa and Madany Mamlouk, Amir and Herrmann-Werner, Anne},
	title = {Assessing medical students’ perceived stress levels by comparing a chatbot-based approach to the Perceived Stress Questionnaire (PSQ20) in a mixed-methods study},
	year = {2022},
