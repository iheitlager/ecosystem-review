	author = {De Simone, L. and Caputo, Enzo and Cinque, Marcello and Galli, Antonio and Moscato, Vincenzo and Russo, Stefano and Cesaro, Guido and Criscuolo, Vincenzo and Giannini, Giuseppe},
	title = {LSTM-based failure prediction for railway rolling stock equipment},
	year = {2023},
