	author = {Xia, Yu and Chen, Qianqian and Huang, Lin and Wei, Mingxia and Wei, Zhenke},
	title = {Influence of Manager Capability on Firms' Adoption Intention of Central Bank Digital Currency: An Empirical Study Based on TOE Framework},
	year = {2025},
	journal = {Journal of Organizational Computing and Electronic Commerce},
