@ARTICLE{Tran2025,
	author = {Tran, Thi Van Hoa and Ngo, Quoc Dung},
	title = {Reimagining Digital Labour Futures in Vietnam: A Causal Layered Analysis Case Study of Socio-Technical Transitions in an Emerging Economy},
	year = {2025},
	journal = {Futures and Foresight Science},
