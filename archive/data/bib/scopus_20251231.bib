@ARTICLE{Wang2023971,
	author = {Wang, Di and Liu, Weihua and Liang, Yanjie and Wei, Shuang},
	title = {Decision optimization in service supply chain: the impact of demand and supply-driven data value and altruistic behavior},
	year = {2023},
	journal = {Annals of Operations Research},
	volume = {324},
	number = {1-2},
	pages = {971 - 992},
	doi = {10.1007/s10479-021-04018-y},
