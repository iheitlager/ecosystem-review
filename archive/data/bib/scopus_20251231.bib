}

@ARTICLE{Mohan202510627,
	author = {Mohan, Roosefert and Uthra, R. Annie and Preetha Roselyn, J.},
	title = {Intelligent and effective means of power utilization in induction furnace controlled melting process of foundry industries reducing CO2 emissions},
	year = {2025},
	journal = {Electrical Engineering},
	volume = {107},
	number = {8},
	pages = {10627 - 10646},
	doi = {10.1007/s00202-025-03049-z},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105001640552&doi=10.1007%2Fs00202-025-03049-z&partnerID=40&md5=f9ce1a829c2017b35c0eeb32cda37b5f},
	abstract = {The electrical energy consumption is increasing day by day to meet customer demand in new industries development, electric vehicle charging, and railways. The intermittent renewable energy resources are integrated in the power grid to meet the increasing demand and to reduce greenhouse emissions. Hence, essential strategy is to reduce the power consumption of the existing industry with the same productivity to make the plant profitable avoiding pollution and global warming. In the foundry industries, furnaces are the key equipment that consumes more power to melt the iron metal scrap to liquid metal for manufacturing castings. To make a foundry profitable, power consumption and worker’s salary are the important parameters since the cost of energy per unit, raw material, and transportation may not be controlled easily by the plant. To optimize the energy cost, each industry is purchasing a limited maximum demand (MD) power since for each allotted MD values in kVA are chargeable whether the maximum limit of the MD is consumed or not. If the allotted MD is crossed at any instant of a time over a billing cycle, there will be a huge penalty for the utilized over the limit in KVA values from the energy supplier. In conventional foundry industries, called Industry 3.0, each furnace has separate circuit breaker switches and a separate maximum demand controller where the MD is set manually based on the expertise suggestions to avoid excess MD penalty. When the MD exceeds this limit, the maximum demand controller of the respective furnace will trip the corresponding circuit breaker. Hence, the furnace that is in production cannot raise the power beyond the maximum demand control limit of that furnace though the designed capacity of the furnace is high. In the proposed system, if power is not utilized by any furnace due to any planned or unplanned stoppage or reduction of power due to operation constraints, the unutilized power is diverted to another furnace to utilize the allotted maximum demand of power in an optimum way within the limit of the allotted MD. In the proposed system, PLC and SCADA are used for digital transformation to achieve Industry 4.0 standards, collecting the actual power consumption data of each furnace and sharing the unutilized power to slave furnaces in an optimum way by using LSTM-based PID controller and adaptive fuzzy logic controller without crossing the allotted maximum demand of the plant and decreases the energy consumption per metric ton of liquid metal production by 7.6%. The conserved electrical energy increases the profit of the plant, reduces CO<inf>2</inf> emission by 557,568 MT per annum to save the world from global warming and pollution, and increases the productivity by 7.1% without affecting the quality of the product. © The Author(s), under exclusive licence to Springer-Verlag GmbH Germany, part of Springer Nature 2025.},
	author_keywords = {Carbon emissions; Energy conservation; Fuzzy logic controller; LSTM-based prediction; Power optimization},
	keywords = {Aviators; Capacitive sensors; Cost reduction; Crushed stone plants; Cupola practice; Cutting machines (mining); Depreciation; Driver licensing; Electric circuit breakers; Electric utilities; Emission control; Fees and charges; Gold deposits; Gold ore treatment; Inductive sensors; Miners; Mining laws and regulations; Permanent mold casting; Pressure pouring; Profitability; Sales; Sand and gravel plants; Scrap metal reprocessing; Shaw process; Silver deposits; Smelting; Stoping; Taxation; Thermostats; Three term control systems; Underwater drilling; Wages; Carbon emissions; Circuit-breakers; CO 2 emission; Energy; Foundry industries; Fuzzy logic controllers; LSTM-based prediction; Maximum demand; Power; Power Optimization; Iron scrap},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Elayah2025228,
	author = {Elayah, Moosa A.},
