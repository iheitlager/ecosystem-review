@ARTICLE{Woods2023,
	author = {Woods, Leanna Sarah and Dendere, Ronald and Eden, Rebekah and Grantham, Brittany M. and Krivit, Jenna and Pearce, Andrew and McNeil, Keith D. and Green, Damian and Sullivan, Clair M.},
	title = {Perceived Impact of Digital Health Maturity on Patient Experience, Population Health, Health Care Costs, and Provider Experience: Mixed Methods Case Study},
	year = {2023},
	journal = {Journal of Medical Internet Research},
	volume = {25},
