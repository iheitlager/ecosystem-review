@ARTICLE{Reed2025,
	author = {Reed, Catherine and Wynn, Martin George and Bown, Gerald Robin},
	title = {Artificial Intelligence in Digital Marketing: Towards an Analytical Framework for Revealing and Mitigating Bias},
	year = {2025},
	journal = {Big Data and Cognitive Computing},
	volume = {9},
	number = {2},
	pages = {},
