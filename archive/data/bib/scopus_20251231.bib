@ARTICLE{Sharma2023102,
	author = {Sharma, Manu and Joshi, Sudhanshu},
	title = {Digital supplier selection reinforcing supply chain quality management systems to enhance firm's performance},
	year = {2023},
	journal = {TQM Journal},
	volume = {35},
	number = {1},
	pages = {102 - 130},
	doi = {10.1108/TQM-07-2020-0160},
