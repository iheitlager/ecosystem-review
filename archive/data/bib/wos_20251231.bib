@article{ WOS:001595764200001,
Author = {Kim, Kyesook and Ahn, Hyunchul and Jo, Hyeon},
Title = {Key Success Factors for Organizational AI Project Success},
Journal = {JOURNAL OF COMPUTER INFORMATION SYSTEMS},
Year = {2025},
Month = {2025 OCT 19},
Abstract = {As companies embrace artificial intelligence (AI), they are shifting
   from digital transformation to AI-centric innovation. This study
   explores the factors influencing AI project success within
   organizations, focusing on two key elements: data availability and
   quality, and AI strategy aligned with business needs. Using a survey of
   249 completed AI projects and analyzed with SmartPLS 4.0, the study
   found that AI strategy was a stronger success factor than data quality.
   Top management support, project champions, and interdepartmental
   collaboration also played significant roles, with top management support
   being the most critical. The findings emphasize the importance of
   strategy and domain knowledge over data and infrastructure, offering
   valuable insights for organizations and stakeholders involved in AI
   projects. This research also supports government efforts to promote AI
   adoption.},
