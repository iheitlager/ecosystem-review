@article{ WOS:000576761700010,
Author = {Faik, Isam and Barrett, Michael and Oborn, Eivor},
Title = {HOW INFORMATION TECHNOLOGY MATTERS IN SOCIETAL CHANGE: AN
   AFFORDANCE-BASED INSTITUTIONAL LOGICS PERSPECTIVE},
Journal = {MIS QUARTERLY},
Year = {2020},
Volume = {44},
Number = {3},
Pages = {1359-1390},
Month = {SEP},
Abstract = {While there has been much work on the relationship between information
   technology (IT) and organizational change, there has been limited
   research that theorizes the relationship between IT and societal change.
   This paper draws on institutional theory, in particular institutional
   logics, to develop a model of IT and societal change, which we argue is
   critical in an era of large-scale digital transformation. Our approach
   is based on a view of society as an interinstitutional system,
   reflecting the multiplicity of logics at the societal level. We
   conceptualize societal change as shifts in the multiplicity of logics,
   with a focus on changes in the levels of centrality and compatibility.
   Our model relates these changes to the materiality of technology through
   the concept of IT affordances. We propose three mechanisms (sensegiving,
   translating, and decoupling) through which IT affordances become
   elements of societal change. We identify three corresponding carriers
   through which IT affordances gain scale and stability (objects,
   networks, and platforms). We discuss the implications of our theoretical
   developments for future research on IT and societal change.},
