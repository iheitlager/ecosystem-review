Month = {DEC},
Abstract = {This paper reflects on the implications of digital transformation for
   international business (IB) theory and research. We briefly discuss its
   potential impact and stress that how digitalization affects traditional
   firms' international strategies remains under-studied. We provide an
   overview of the papers in this Special Issue which aspire to answer this
