@article{ WOS:001551836200001,
Author = {Jian, Guanqun and Meng, Yiming},
Title = {The Impact of China's SRDI Qualification Accreditation Policy on the
   Low-Carbon Resilience of SMEs},
Journal = {EMERGING MARKETS FINANCE AND TRADE},
Year = {2025},
Month = {2025 AUG 16},
Abstract = {Shaping the low-carbon resilience of small and medium-sized enterprises
   (SMEs) is becoming increasingly important for promoting high-quality
   economic growth. This study leverages data from A-share listed companies
   in Shanghai and Shenzhen from 2016 to 2023 to examine the relationship
   between the ``Specialized, Refinement, Differential and Innovation{''}
   (SRDI) qualification accreditation policy and the low-carbon resilience
   of SMEs utilizing a multi-temporal double difference method. The
   findings indicate that the SRDI qualification accreditation policy
   enhances SMEs' low-carbon resilience, with more pronounced effects on
   non-state-owned firms and polluting SMEs. Mechanistic analyses suggest
   that the recognition tactics under the SRDI qualification accreditation
   may bolster SMEs' low-carbon resilience through digital transformation,
   government subsidies, industry-academia partnerships, and synergistic
   clustering mechanisms within industries. These results provide valuable
   insights and implications for global SMEs to adopt chain thinking,
   improve low-carbon resilience, and optimize their innovation ecosystems.},
