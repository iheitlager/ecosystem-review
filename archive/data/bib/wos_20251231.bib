@article{ WOS:001491399500001,
Author = {Xie, Guanxia and Hou, Xiaojuan and Chu, Pengfei},
Title = {Green Spillover Effects of Corporate Digital Transformation: Evidence
   from a Supply Chain Perspective},
Journal = {EMERGING MARKETS FINANCE AND TRADE},
Year = {2025},
Month = {2025 MAY 18},
Abstract = {Using data from publicly listed firms in China from 2008 to 2022, this
   paper examines the green spillover effects of customer firms' digital
   transformation on suppliers' environmental performance from a supply
   chain perspective. The results show that customer firms' digital
   transformation improves suppliers' environmental awareness and
   performance by enhancing supply chain transparency and alleviating
   financial constraints. This effect is particularly significant in
   state-owned enterprises, firms with high supplier concentration,
   low-pollution firms, and high-tech industries. In contrast, high
   supplier and customer concentration weaken these effects by reducing
   competitive pressures and innovation incentives. Supply chain
   transaction costs and geographical distance dampen this green spillover
   effect.},
