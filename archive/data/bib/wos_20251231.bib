Affiliation = {Zhang, Y (Corresponding Author), Beijing Univ Chem Technol, Sch Econ \& Management, Beijing, Peoples R China.
   Liu, Jiajia; Wang, Yahan; Chen, Meilin; Yang, Zhe; Zhang, Ye, Beijing Univ Chem Technol, Sch Econ \& Management, Beijing, Peoples R China.},
