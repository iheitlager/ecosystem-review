@article{ WOS:001215797300001,
Author = {Han, Dongri and Zhu, Yue and Diao, Yanxia and Liu, Min and Shi, Ziyi},
Title = {The impact of new digital infrastructure construction on substantive
   green innovation},
Journal = {MANAGERIAL AND DECISION ECONOMICS},
Year = {2024},
Volume = {45},
Number = {6},
Pages = {4072-4083},
Month = {SEP},
Abstract = {The new digital infrastructure is the cornerstone of the digital
   transformation of the regional innovation ecosystem and the key engine
   driving green, low-carbon, and intelligent development in the era of the
   digital economy. The findings demonstrate that substantive green
   innovation is significantly positively impacted by the new digital
   infrastructure, and its effect shows a ``Central > Eastern >
   Western.{''} New digital infrastructure construction can indirectly
