@article{ WOS:001521568200024,
Author = {Zhou, Xiao and Han, Jing and Li, Yan and Zhang, Guodong},
Title = {Further Analysis on Fixed/Preassigned-Time Projective Synchronization of
   Discontinuous Fuzzy Delayed Inertial Neural Networks},
Journal = {IEEE ACCESS},
Year = {2025},
Volume = {13},
Pages = {109294-109307},
Abstract = {Our goal is addressing the problems of preassigned-time projective
   synchronization and fixed-time projective synchronization of the system
   that studied in our article, and fuzzy terms, mixed delays, inertial
   terms and discontinuous activation function are also included in this
   system. And the results of this article are based on the latest
   fixed-time stabilization lemma. Through the construction of adaptative
   Lyapunov function and new corresponding feedback controllers, we arrive
   at the results of fixed-time projective synchronization and
   preassigned-time projective synchronization about investigated neural
   networks, and we are using a non-reduced-order approach. The proposed
   results are more extensive in comparison with traditional
   anti-synchronization and synchronization. To validate the theoretical
   findings, we provide numerical simulations demonstrating the
   effectiveness and advantages of the proposed control schemes.
   Furthermore, we provided confidential communications to further verify
   the validity of the results.},
