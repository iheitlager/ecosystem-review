@article{ WOS:001317667700001,
Author = {Cerchione, Roberto and Centobelli, Piera and Borin, Elena and Usai,
   Antonio and Oropallo, Eugenio},
Title = {The WISED knowledge-creating company: rethinking SECI model in light of
   the digital transition},
Journal = {JOURNAL OF KNOWLEDGE MANAGEMENT},
Year = {2024},
Volume = {28},
Number = {10},
Pages = {2997-3022},
Month = {NOV 19},
Abstract = {PurposeThe effect of digital transition on knowledge management (KM)
   processes is becoming relevant for companies operating in different
   industries and the body of literature examining this impact is rapidly
   growing. This paper aims to critically analyse the literature on the
   impact of digital transition on KM by rethinking the SECI model proposed
   by Nonaka and proposing the WISED model for the digital
   knowledge-creating company.Design/methodology/approachThe
   systematisation of existing studies on the topic and the analysis of the
   evolution of knowledge creation process in the era of digital transition
   was carried out through a bibliometric approach.FindingsAccording to the
   traditional epistemological and ontological dimensions and considering
   the innovative KM processes identified by this study (i.e. webification,
   informalisation, systematisation, explicitation and digitalisation), the
   results highlight how the proposed WISED model can be adopted by
   organizations to manage knowledge through the use of digital
   technologies.Originality/valueDigital transition seems to open up new
   horizons that can expand the potential use of the WISED model for
   organisations and society.},
Publisher = {EMERALD GROUP PUBLISHING LTD},
Address = {Floor 5, Northspring 21-23 Wellington Street, Leeds, W YORKSHIRE,
   ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Oropallo, E (Corresponding Author), Univ Roma La Sapienza, Dept Comp Control \& Management Engn Antonio Rubert, Rome, Italy.
