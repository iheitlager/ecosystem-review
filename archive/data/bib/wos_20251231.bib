@article{ WOS:000476518500002,
Author = {Braun, Timo and Sydow, Joerg},
Title = {Selecting Organizational Partners for Interorganizational Projects: The
   Dual but Limited Role of Digital Capabilities in the Construction
   Industry},
Journal = {PROJECT MANAGEMENT JOURNAL},
Year = {2019},
Volume = {50},
Number = {4},
Pages = {398-408},
Month = {AUG},
Abstract = {The selection of partners is critical for the success of
   interorganizational projects. Based on conceptual reasoning in light of
   prior research, as well as illustrative empirical insights into an
   ongoing interorganizational project in the construction industry, we
   argue that partner selection practices not only target the
   organizational capabilities of potential partners but they themselves
   require an organizational capability to search for, evaluate, and
   select. This article delineates the facets of this capability, reveals
   the role of digital capabilities therein, and shows that the respective
   capabilities are crucial for inclusion and exclusion in
   interorganizational projects. The results also point to capabilities
   that emerge at the interorganizational nexus.},
