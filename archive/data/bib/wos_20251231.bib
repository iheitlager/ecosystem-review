@article{ WOS:001584287600001,
Author = {Loh, Xiu-Ming and Shyu, Wen-Hwa and Lee, Voon-Hsien and Huang, Hui-Ling
   and Tan, Garry Wei-Han and Ooi, Keng-Boon},
Title = {Super App: A Multi-Analytical Cross-Country Approach on the
   ``Everything{''} App},
Journal = {JOURNAL OF COMPUTER INFORMATION SYSTEMS},
Year = {2025},
Month = {2025 SEP 29},
Abstract = {In contrast with single-purpose mobile apps, super apps provide multiple
   diversified services that address a broad range of user needs. As it is
   relatively nascent, further research is required to determine the
   antecedents of continuance intention toward super apps. Therefore, a
   research model was developed by integrating an extended Mobile
   Expectation-Confirmation Model and multidimensional concept of
   relationship quality. The Partial Least Square-Structural Equation
   Modeling and Necessary Condition Analysis were used to analyze 494
   responses which were collected in Malaysia and Taiwan. The results
   revealed that except for the relationship between enjoyment and
   continuance intention, all other relationships were significant for both
   countries. Practically, this study offers insights to enhance the
   development and localization strategies for super app service providers.
   Theoretically, this study extends the literature by utilizing a
   multi-analytical cross-country approach to investigate continuance
   intention toward super apps with an integrated research model.},
