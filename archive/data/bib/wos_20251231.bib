Pages = {340-356},
Month = {OCT 1},
Abstract = {We explore motivations for adopting Business Process Management (BPM) by
   analyzing 290 customer use cases published on-line by BPM systems
   vendors. We construct a classification framework of BPM motivations for
   the new challenges confronting BPM in the time of digital
   transformation, with highlights of the new role of BPM in this context.
   The proposed framework serves as a guide for future research on BPM
   motivation patterns, particularly in the context of digital
