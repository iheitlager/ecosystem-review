   ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Chin, T (Corresponding Author), Honghe Univ, Coll Business, Mengzi, Peoples R China.
   Duan, Yunlong, Yunnan Univ Finance \& Econ, Div Sci \& Technol Adm, Kunming, Yunnan, Peoples R China.
   Yang, Meng, Yunnan Univ Finance \& Econ, Business Sch, Kunming, Yunnan, Peoples R China.
   Liu, Hanxiao, Yunnan Univ Finance \& Econ, Sch Econ, Kunming, Peoples R China.
   Chin, Tachia, Honghe Univ, Coll Business, Mengzi, Peoples R China.},
DOI = {10.1108/JKM-02-2023-0161},
