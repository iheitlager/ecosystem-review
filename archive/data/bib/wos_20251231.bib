Year = {2023},
Volume = {54},
Number = {4, SI},
Pages = {409-427},
Month = {AUG},
Abstract = {Program management continues to gain traction as an approach to managing
   the development and implementation of advanced information technology
   (IT). The guidance and structure provided by program principles and
   processes enhance an organization's ability to achieve the benefits of a
   large-scale IT deployment. However, realizing the benefits of
   contemporary IT to support organizational strategy is proving
   problematic. In this study, we conduct a conceptual and critical review
   of the IT program management literature to determine the current
   research in achieving success and develop frameworks that encourage
   coordinated studies to address further benefits from IT programs with
   differing strategic purposes.},
