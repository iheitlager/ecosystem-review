@article{ WOS:000835621300002,
Author = {Amoroso, Sara and Diodato, Dario and Hall, Bronwyn H. and
   Moncada-Paterno-Castello, Pietro},
Title = {Technological relatedness and industrial transformation: Introduction to
   the Special Issue},
