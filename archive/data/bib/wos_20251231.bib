@article{ WOS:000787998400001,
Author = {Wang, Wei and Huang, Xucheng and Luo, Shougui},
Title = {Measuring Enterprise Mutual Information Based on the Helix Model},
Journal = {JOURNAL OF ORGANIZATIONAL AND END USER COMPUTING},
Year = {2022},
Volume = {34},
Number = {7},
Abstract = {In the context of digital transformation, this emerging technology input
   creates powerful digital capabilities. Despite of the long distance, the
   enterprises cooperate more closely through wireless networks in digital
   space than ever before. Thus, the digital technology has fundamentally
   changed the total performance of Shanghai-based enterprises over the
   2016-2020 period. This paper creatively explores the influence mechanism
   of digital transformation through the mutual information measures on
   enterprise development. The authors use the helix model to the
   interactive relationship transformation among location, industry,
   vertical industrial linkages, and cooperative partners for the
   enterprises, which are based on the degree of link among the quadruple
   variables. It shows transformation of enterprise structure and
   innovation and performance by measuring the mutual information. As a
   result, this paper reveals transformation of the total performance with
   emerging technologies. In addition, it shows the transformation of
   industrial and spatial structure in Shanghai by comparing other
   countries.},
