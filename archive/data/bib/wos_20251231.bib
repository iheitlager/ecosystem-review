@article{ WOS:001503014600001,
Author = {Barile, Domenica and Secundo, Giustina and Del Vecchio, Pasquale},
Title = {An artificial intelligence-based innovation ecosystem enabling open
   innovation and sustainable growth: evidence from a case study},
Journal = {INNOVATION-ORGANIZATION \& MANAGEMENT},
Year = {2025},
Month = {2025 JUN 5},
Abstract = {This article aims to shed new light on the role of Artificial
   Intelligence (AI) as a fundamental enabler of Open Innovation (OI)
   within innovation ecosystems (IEs). Specifically, it explores how an
   AI-based platform can optimise decision-making processes and foster the
   collaborative development of new products, services, and prototypes
   within IEs. The study presents a case study of Lutech Campus, an OI hub
   led by an international company specialising in comprehensive digital
   technology solutions. Specifically, the study examines how an AI
   platform serves as the backbone of the Lutech AI-based IE, facilitating
   knowledge sharing, optimising decision-making, and accelerating the
   development of sustainable solutions. The Lutech ecosystem enables
   seamless collaboration among companies, start-ups, academic
   institutions, and other key stakeholders through AI-driven analytics and
   automation, thereby fostering a dynamic and AI-powered OI process. The
   findings highlight that an AI-based IE can enhance OI dynamics, improve
   knowledge dissemination, accelerate innovation processes, and promote
   long-term value creation. Furthermore, sustainability is embedded in
   both the processes and outcomes of innovation, ensuring the integration
   of environmental, social, and governance (ESG) principles and alignment
   with sustainable development goals (SDGs). Finally, this study presents
   an AI-based IE framework, offering both theoretical insights and
   practical implications.},
