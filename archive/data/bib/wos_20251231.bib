@article{ WOS:001572948400001,
Author = {Hao, Xionglei and Wen, Xiaoman},
Title = {Strategic management of industrial digital transformation: insights from
   local government behaviour models},
Journal = {TECHNOLOGY ANALYSIS \& STRATEGIC MANAGEMENT},
Year = {2025},
Month = {2025 SEP 18},
Abstract = {Industrial digital transformation has become a key strategy for
   enhancing productivity, efficiency, and competitiveness across
   industries. This study explores the role of local governments in driving
   industrial digital transformation, identifying their strategies for
   leveraging digital technologies to promote sustainable development.
   Using a mixed-methods approach, the research incorporates qualitative
   data from in-depth interviews with 47 local government officials,
   analyzed using NVivo, and quantitative data from an online survey of 565
   participants, analyzed using SPSS. The findings highlight that increased
   investment in digital infrastructure enables local governments to
   support transformation efforts proactively. Greater regulatory
   flexibility accelerates digital initiatives, while strong collaborative
   networks with industry stakeholders and technology innovators enhance
   project success. Additionally, active stakeholder engagement fosters
   higher adoption rates of digital technologies, and effective data
   governance frameworks help local governments optimise digital tools for
   sustainable industrial growth. The study contributes novel insights into
   how local governments strategically manage digital transformations,
   offering valuable guidance for policymakers seeking to enhance digital
   adoption and industrial modernisation.},
