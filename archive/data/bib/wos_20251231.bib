@article{ WOS:001538935500001,
Author = {Mohanta, Pulok Ranjan and Mahanty, Biswajit},
Title = {An empirical investigation into the factors influencing the upgrading of
   the Indian manufacturing MSMEs to Industry 4.0},
Journal = {TECHNOLOGY ANALYSIS \& STRATEGIC MANAGEMENT},
Year = {2025},
Month = {2025 JUL 31},
Abstract = {This empirical research investigates the critical success factors (CSFs)
   influencing the Industry 4.0, upgrading of the Indian manufacturing
   MSMEs. The research is essential considering (1) the crucial
   contribution of MSMEs in socio-economic development, (2) the role of
   advanced technologies in sustaining their competitiveness and (3) their
   deficiency in resources and capability for upgrade. Adequate
   understanding of the CSFs provides valuable insights useful for
   formulating policies and strategies to handhold. We surveyed 222 MSMEs,
   capturing the enabling power of twenty CSFs gleaned from the literature.
   Through exploratory factor analysis, we identified six latent variables
   within which all the CSFs can be grouped. Using structural equation
   modelling, we examined the influencing relationships among the
   identified latent variables. The findings highlight the importance of
   advanced technologies for information acquisition and processing, as
   well as advanced network and information management systems for Industry
   4.0 upgrade. However, our findings also raise concerns about the
   undesirable effect of collaboration and the possibility of deskilling
   due to upgrades.},
