@article{ WOS:001361202100001,
Author = {Artusi, Federico and Magistretti, Stefano and Bellini, Emilio and
   Dell'Era, Claudio},
Title = {Technology-Aided Customer Experience Innovation: Implementation Modes in
   Retail},
Journal = {CREATIVITY AND INNOVATION MANAGEMENT},
Year = {2025},
Volume = {34},
Number = {2},
Pages = {414-426},
Month = {JUN},
Abstract = {Retailers are increasingly leveraging emerging digital technologies to
   enhance and deliver memorable and timely customer experiences. However,
   more research is needed to understand how these technologies are being
   implemented. Therefore, we conducted an fsQCA analysis of 32 retail
   cases of early adopters of beacon technology. Our findings reveal three
   main modes of implementation of emerging digital technologies in the
   retail customer experience: automation, augmentation, and customization.
   These modes can be interpreted as enablers that enhance the value of
   utilitarian and/or hedonic experiences, rather than as drivers of
   innovation per se. Our study adds a new perspective to the debate about
   the role of digital technologies in driving innovation. Moreover, the
   three modes identified provide managers with practical guidelines for
   the implementation of emerging digital technologies in retail
   environments.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
