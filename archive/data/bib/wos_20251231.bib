@article{ WOS:001173538000001,
Author = {Liu, Huizheng and Pan, Wenshen},
Title = {A comprehensive literature review of the digital business ecosystem and
   digital business model with comparison in China, Japan and South Korea},
Journal = {ASIA PACIFIC BUSINESS REVIEW},
Year = {2024},
Month = {2024 MAR 4},
Abstract = {Digitalization has led to new value co-creation networks in the form of
   digital business ecosystems and digital business models. This paper
   systematically analyses the research on digital business ecosystems and
   digital business models by applying the bibliometric analysis method to
   investigate current research on cooperation networks and clusters. We
   have found that the current research can be mainly divided into the
   following topics: the adoption of digital technologies, digital
   innovation and digital transition, platforms and the sharing economy,
   dynamic capabilities and sustainable development. Additionally, we
   further analyse future research directions and compare research hotspots
   in the Asia Pacific region.},
