@article{ WOS:001410272700001,
Author = {Ricardez-Estrada, Josselyne and Garay-Rondero, Claudia Lizette and
   Romero, David and Wuest, Thorsten and Pinto, Roberto},
Title = {A reference framework for Supplier 4.0 development programs: a Delphi
   study},
Journal = {INTERNATIONAL JOURNAL OF LOGISTICS-RESEARCH AND APPLICATIONS},
Year = {2025},
Month = {2025 FEB 1},
Abstract = {In the Global Manufacturing sector, the evolving dynamics and prospects
   of Digital Supply Chains (DSCs) are revolutionising the way Supply Chain
   (SC) actors operate and collaborate, requiring suppliers to embark on a
   digital transformation journey to build Digital Capabilities (DCs). Yet,
   current Supplier Development Programs (SDPs) have limited focus on
   building DCs for the next generation of suppliers, referred to here as
   `Suppliers 4.0'. This research presents a Reference Framework designed
   to support the creation and management of Supplier 4.0 Development
   Programs (S4.0DPs) that contribute to the digitalisation and digital
   integration of SCs through the digitalisation of their actors. The
   proposed S4.0DPs Reference Framework was validated using a two-round
   Delphi study that included international experts from industry and
   academia. This research contributes to the systematisation of the
   knowledge needed to support the Digital Transformation of SCs and their
   actors, aligning the interests of the focal company and its supplier
   base.},
