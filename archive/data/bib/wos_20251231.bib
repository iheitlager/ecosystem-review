@article{ WOS:001531044100001,
Author = {Le, Minh-Hieu and Tran, Phung Phi},
Title = {From crisis to control: big data solutions for risk management in supply
   chains},
Journal = {INTERNATIONAL JOURNAL OF LOGISTICS-RESEARCH AND APPLICATIONS},
Year = {2025},
Month = {2025 JUL 19},
Abstract = {Global supply chains suffer billions in annual losses from unforeseen
   disruptions, emphasising the need for advanced risk management. This
   study explores Big Data's role in mitigating such risks by analyzing
   1,222 articles from 2003-2024, a period of rapid digital transformation.
   Findings show blockchain enhances real-time tracking and transparency,
   especially in logistics, while machine learning improves predictive
   analytics for demand forecasting and vaccine cold chain logistics. China
   and the United States contribute significantly due to strategic digital
   investments and international collaborations. Rather than listing
   authors, the study highlights key themes such as AI-enabled risk
   mitigation and blockchain-based transparency. It also maps institutional
   collaboration and examines how IoT and automation support real-time risk
   detection across supply chains. The study provides actionable insights
