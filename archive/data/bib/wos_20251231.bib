@article{ WOS:001610998600001,
Author = {Gao, Kaibo and Chen, Xiaofeng and Du, Xinyi and Jiang, Kangqi},
Title = {Supplier concentration and corporate digitalisation: an empirical study
   using machine learning techniques},
Journal = {INTERNATIONAL JOURNAL OF LOGISTICS-RESEARCH AND APPLICATIONS},
Year = {2025},
Month = {2025 NOV 5},
Abstract = {In the digital era, corporate digital transformation has become a
   crucial strategy for enhancing competitive advantage. This study
   investigates the relationship between supplier concentration and
   corporate digital transformation using a hybrid methodology of Ordinary
   Least Squares regression and multiple machine learning techniques. Our
   analysis reveals that higher supplier concentration impedes corporate
   digital transformation, with more pronounced negative effects on
   relatively smaller listed firms, state-owned enterprises, high-tech
   firms, and non-consumer sectors. We find that supplier concentration
   primarily obstructs digital transformation by diminishing a firm's
   negotiating power, elevating operational risks, and increasing financing
   costs. Furthermore, our results identify a significant spillover effect:
   a firm's high supplier concentration also inhibits the digital
   transformation of its suppliers. This research provides new evidence on
   the barriers to corporate digital transformation and contributes to
   methodological exploration in digital economy research.},
