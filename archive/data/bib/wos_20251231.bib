@article{ WOS:001604174700001,
Author = {Xiao, Youzhi and Liu, Xin},
Title = {Does Digital Transformation Improve the Firm Cooperation-Oriented
   Culture?},
Journal = {EMERGING MARKETS FINANCE AND TRADE},
Year = {2025},
Month = {2025 OCT 29},
Abstract = {The Actor-Network Theory suggests that technology is a factor-reshaping
   culture. The firm digital transformation involves the introduction and
   applications of emerging digital technologies, which may generate
   impacts on firms' culture. Using data of Chinese A-share listed firms
   from 2010 to 2022, we examine the impact of digital transformation on
   firm cooperation-oriented culture. We find that the digital
   transformation can significantly promote the firm cooperation-oriented
   culture. The heterogeneity analysis shows that the positive functions
   are weakened for firms located in the areas that mainly plant rice and
   with higher social trust, as well as for firms with higher internal
   trust and higher ratio of female executives. For different components of
   digital transformation, the digitization strategy and digitization
   application impose more significant positive effects. For the different
   technologies, big data technology and non-machine digital transformation
   play a more active role. The plausible channels further show that the
   firm digital transformation shortens the cooperation distance, promotes
   firm innovation, improves firm transparency, emphasizes the concept of
   sharing, and improves the positive attitude, thus promoting a
   cooperation-oriented culture.},
