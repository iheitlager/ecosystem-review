@article{ WOS:001566565000001,
Author = {Sood, Rhijul and Laishram, Boeing},
Title = {Quantitative analysis of lean construction to enhance BIM implementation
   for FM: an SNA based approach},
Journal = {INTERNATIONAL JOURNAL OF LEAN SIX SIGMA},
Year = {2025},
Month = {2025 SEP 10},
Abstract = {PurposeThis study aims to use social network analysis (SNA) to
   quantitatively illustrate the extent to which various lean construction
   (LC) principles can help address the barriers affecting the
   implementation of building information modeling (BIM) for effective
   facility management (FM) of new and existing built
   assets.Design/methodology/approachA comprehensive analysis of the extant
   literature was done to identify the underlying barriers to BIM adoption
   during the operations and maintenance (O\&M) phase and the role of LC in
   enhancing BIM implementation for FM. Additionally, eight BIM and Lean
   experts belonging to the Institute for Lean Construction Excellence
   (ILCE) were interviewed to understand the existing maturity of BIM in
   the O\&M phase and the role of LC to enhance its implementation for
   effective FM. This study then used SNA-based tools for analyzing the
   collected matrix-based data that associates the LC principles with
   corresponding barriers.FindingsThe study concluded that LC principles
   can significantly address technical and non-technical barriers. Value
   for customers, developing partnerships and collaborations and
   standardization are found to be the most significant LC principles with
   high levels of degree centrality and eigenvector
   centrality.Originality/valueThe study's results add to the existing body
   of knowledge by quantitatively establishing that LC principles can
   enhance the implementation and use of BIM for O\&M of various new and
   existing facilities. The study also provides a roadmap for the
   construction stakeholders to implement lean culture in their
   organizations before adopting any digital innovation to comprehend
   continuous improvement.},
