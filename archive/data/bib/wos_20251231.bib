Language = {English},
Affiliation = {He, YH (Corresponding Author), North China Univ Technol, Sch Informat, Beijing 100144, Peoples R China.
   He, Yunhua; Luo, Mingshun; Xiao, Ke, North China Univ Technol, Sch Informat, Beijing 100144, Peoples R China.
   Wu, Bin; Sun, Limin, Chinese Acad Sci, Inst Informat Engn, Beijing 100864, Peoples R China.
   Wu, Yongdong; Liu, Zhiquan, Jinan Univ, Coll Cyber Secur, Guangzhou 510632, Peoples R China.},
DOI = {10.1109/JIOT.2023.3282732},
ISSN = {2327-4662},
