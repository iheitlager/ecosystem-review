@article{ WOS:001562209800001,
Author = {Cheng, Qiang and Peng, Chun and Dai, Yuanhui and Zhang, Shuangyang},
Title = {Unlocking interorganizational knowledge sharing: the mediating role of
   knowledge digitization in the age of digital innovation},
Journal = {JOURNAL OF KNOWLEDGE MANAGEMENT},
Year = {2025},
Month = {2025 SEP 4},
Abstract = {PurposeThe iterative evolution of digital technology has dramatically
   changed the practice of knowledge sharing. Digital innovation, based on
   digital technology, accelerates the digitization of knowledge, thus
   affecting knowledge sharing among organizations. This paper aims to
   examine how digital innovation can facilitate interorganizational
   knowledge sharing and the important role of knowledge
   digitization.Design/methodology/approachThe sample consists of 304
   members from digital groups in China who participate in
   interorganizational collaboration and collaborative innovation
   activities. This paper uses PLS-SEM to examine the relationship between
   digital innovation (distributed and combined digital innovation),
   knowledge digitization (codability, convergence and generativity) and
   interorganizational knowledge sharing.FindingsThe results show that
   distributed and combined digital innovation have a significant positive
   impact on interorganizational knowledge sharing, and codability,
   convergence and generativity play a mediating role in them.Practical
   implicationsThe conclusions emphasize the importance of digital
   innovation and knowledge digitization and provide directions for
   realizing interorganizational knowledge sharing in the digital age,
   improving the innovation ability of organizations, expanding knowledge
   heterogeneity and organizational competitiveness.Originality/valueBased
   on the existing research, this paper further clarifies the
   classification of digital innovation. This study focuses on the
   relationship between digital innovation and interorganizational
   knowledge sharing and further discusses the implementation mechanism of
   interorganizational knowledge sharing in the digital context. This study
   also perfects the related research of knowledge digitization and
   provides a theoretical basis for the further research.},
