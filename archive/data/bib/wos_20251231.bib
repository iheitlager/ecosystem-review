@article{ WOS:001320513300001,
Author = {Wan, Lijun and Liu, Lirui and Yin, Shi and Mahmood, Tahir and Pamucar,
   Dragan and Xiong, Fengshan},
Title = {Greenization and Digitization Transformation of Hydrogen Energy
   Technology Based on a Fuzzy Decision-Making Model},
Journal = {IEEE ACCESS},
Year = {2024},
Volume = {12},
Pages = {132390-132408},
Abstract = {The global energy transition is increasingly driven by hydrogen energy,
   making digital green innovation crucial for hydrogen energy enterprises.
   This article explores effective strategies for these enterprises to
   select digital green innovation partners and provides actionable
   guidance for their transformation and development. First, an evaluation
   index system is developed using fuzzy set theory, grounded in the
   principles of digital green innovation partner selection for hydrogen
   energy enterprises. Next, a dual-combination weighting evaluation method
   is proposed, integrating combination weighting theory and field theory
   to build a decision model that supports partner selection for these
   companies. The model is then applied in a real-world case analysis of
   Baotailong, demonstrating its practical effectiveness in addressing
   digital green innovation challenges within hydrogen energy enterprises.
   The study concludes that a green and digital transformation approach,
   guided by a fuzzy decision-making model, enables hydrogen energy
   companies to identify suitable innovation partners. This approach not
   only aligns with the broader trends of socio-economic development but
   also enhances the companies' core competitiveness.},
