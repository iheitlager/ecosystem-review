@article{ WOS:000763037600004,
Author = {Baltuttis, Dennik and Hackel, Bjorn and Jonas, Claudius Michael and
   Oberlander, Anna Maria and Roglinger, Maximilian and Seyfried, Johannes},
Title = {Conceptualizing and Assessing the Value of Internet of Things Solutions},
Journal = {JOURNAL OF BUSINESS RESEARCH},
Year = {2022},
Volume = {140},
Pages = {245-263},
Month = {FEB},
Abstract = {The Internet of Things (IoT) is associated with enormous economic
   potential. To date, however, actual revenues remain below expectations.
   This circumstance particularly affects IoT solution providers in
   industrial contexts where effective value assessment is critical for
   market success. Since a deeper understanding of how IoT solutions create
   value is required to address this challenge, we develop a framework and
   corresponding value levers for assessing the value of IoT solutions
   along an archetypical yet configurable business-to-business-to-consumer
   (B2B2C) value chain. Taking the perspective of an IoT solution provider
   in the industrial context, we evaluate the framework with five such
   solution providers and apply the value levers for an initial value
   quantification. Our work extends previous research and furthers
   knowledge on the business value of IT and IoT. It also supports
   practitioners in assessing IoT value potential.},
