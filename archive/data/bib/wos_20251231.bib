@article{ WOS:000670673700001,
Author = {Barata, Joao},
Title = {The fourth industrial revolution of supply chains: A tertiary study},
Journal = {JOURNAL OF ENGINEERING AND TECHNOLOGY MANAGEMENT},
Year = {2021},
Volume = {60},
Month = {APR-JUN},
Abstract = {This paper unfolds the ongoing fourth revolution of supply chains (4SC)
   and proposes guidelines for future research. The review of sixty-five
   literature reviews follows three stages: bibliometric analysis of
   Industry 4.0, its synergies with supply chain transformation, and
   state-of-the-art assessment. 4SC is a context-bound technological change
   driven by organizational and cultural priorities, aiming to create more
   sustainable networks to serve the customers and support responsible
   decisions in the supply lifecycle. The proposed framework can assist
   future literature reviews and digital transformation proposals for 4SC
   that need to frame their context and incorporate functions to endure
   change.},
