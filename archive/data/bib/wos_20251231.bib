@article{ WOS:001567914800001,
Author = {Ladeira, Catarina S. B. and Ferreira, Joao J. M.},
Title = {Multinational enterprises in global value chains using MCA approach:
   mapping the field and future research},
Journal = {INTERNATIONAL MARKETING REVIEW},
Year = {2025},
Month = {2025 SEP 9},
Abstract = {PurposeThis study reviews the literature on multinational enterprises
   (MNEs) within global value chains (GVCs), aiming to enhance
   understanding of MNEs' roles, identify key themes, theoretical
   approaches and propose a research agenda.
   Design/methodology/approachUtilizing a systematic literature review and
   multiple correspondence analysis (MCA), the study categorizes key themes
   across 202 articles published between 2004 and 2024. FindingsThe review
   highlights the transformation of MNEs' strategic governance approaches
   and identifies four key thematic poles: ``Upgrading and
   Competitiveness,{''} ``Advanced Strategies and Innovation,{''} ``Global
   Clusters Network and Cultural Influences,{''} and ``Strategic Location
   Choice and Disruptive Technologies,{''} emphasizing digital
   transformation, regional complexities and competitive upgrading within
   GVCs. Research limitations/implicationsThe focus on English articles and
   high-impact journals may exclude some relevant literature, and the
   concentration on certain sectors may not fully represent diverse MNE
   contexts. The review integrates internalization theory, resource-based
   view, dynamic capabilities and institutional theory, highlighting
   technological innovation and institutional influences. Practical
   implicationsThe findings offer insights for MNEs to improve strategic
   location choices, leverage emerging technologies and enhance
   competitiveness. Policymakers can design supportive policies promoting
   economic integration and innovation. Social implicationsThe study
   underscores the importance of corporate social responsibility and
   sustainability practices within GVCs, highlighting the role of digital
   technologies in improving transparency and effectiveness. It calls for
   robust governance mechanisms to address environmental impact and working
   conditions. Originality/valueThis study maps the intellectual structure
   of research on MNEs in GVCs, offering insights into regionalization,
   digitalization and governance, and proposes a research agenda addressing
   critical gaps.},
