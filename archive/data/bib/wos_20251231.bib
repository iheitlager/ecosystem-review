@article{ WOS:001100498400001,
Author = {Chen, Zhisheng},
Title = {Revolutionising HRM practice with blockchain technology: unleashing
   disruptive paradigms of work and overcoming management challenges},
Journal = {TECHNOLOGY ANALYSIS \& STRATEGIC MANAGEMENT},
Year = {2025},
Volume = {37},
Number = {2},
Pages = {125-138},
Month = {FEB 1},
Abstract = {Blockchain technology is anticipated to have a significant impact on
   human resource management (HRM) in the era of Industry 4.0. This study
   employs a literature review methodology and examines 42 relevant
   publications to identify key areas where blockchain technology can be
   applied in HRM. The findings reveal several crucial applications of
   Blockchain in HRM. Firstly, blockchain technology can effectively
   prevent interview fraud and enhance the reliability of the recruitment
   process. Secondly, it can improve training and certification processes,
   address pay equity issues, ensure fair performance evaluations, and
   facilitate employee relations. These applications are vital in enhancing
   the efficiency and accuracy of HRM practices. However, the study also
   highlights certain management concerns related to adopting blockchain
   technology, such as management's commitment, stakeholder collaboration,
   and data breach risks. Building upon these findings, a comprehensive
   discussion is initiated, summarising the contributions and critical
   findings of the research and emphasising the potential advantages of
   integrating blockchain technology into HRM. Additionally, the study
   examines the contributions made by existing literature and proposes
   directions for future research. Finally, a research agenda is put forth
   to explore the effective implementation of blockchain technology in
   practical HRM.},
