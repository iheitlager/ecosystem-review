@article{ WOS:001487468500001,
Author = {Thai, Huy-Cuong Vo and Tran, My-Linh},
Title = {Digitalisation-driven growth: elevating SMEs through capability
   reconfiguration and business model innovation in Vietnam},
Journal = {TECHNOLOGY ANALYSIS \& STRATEGIC MANAGEMENT},
Year = {2025},
Month = {2025 MAY 13},
Abstract = {This study examines capability reconfiguration within digitalisation
   strategies for Vietnamese small - and medium-sized enterprises (SMEs)
   utilising the dynamic capabilities framework. The research investigates
   the potential benefits of targeted reconfigurations to maximise
   digitalisation opportunities and foster business model innovation.
   Through structural equation modelling, we analyze the dynamics governing
   these relationships of 492 SMEs. Findings indicate that CPS
   significantly enhances process digitalisation, while CPE strongly
   influences product and service digitalisation. A non-significant effect
   was found between capability reconfiguration and digital collaboration
   adoption among Vietnamese SMEs. However, technological and market
   turbulence positively impact digital collaboration adoption. The study
   emphasises the critical role of investments in digitalisation for client
   communication in responding to market turbulence and competitive
   intensity. It contributes to understanding the strategic alignment of
   capabilities with business goals in navigating digital transformation
   complexities.},
