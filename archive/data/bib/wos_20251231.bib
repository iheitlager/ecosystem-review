@article{ WOS:001454999600001,
Author = {Shahzad, Muhammad Farrukh and Asif, Muhammad and Xu, Shuo and Wang,
   Congcong},
Title = {Impact of digitalization on entrepreneurial ecosystems: a bibliometric
   exploration},
Journal = {JOURNAL OF BUSINESS \& INDUSTRIAL MARKETING},
Year = {2025},
Volume = {40},
Number = {3},
Pages = {782-795},
Month = {APR 10},
Abstract = {PurposeThis study emphasizes digitalization in entrepreneurial
   ecosystems, fostering sustainability and redefining how businesses
   operate and entrepreneurs innovate. This study aims to examine trends
   and key contributions to digitalization in entrepreneurial ecosystems,
   focusing on organizational cultures and their
   influence.Design/methodology/approachUsing the PRISMA framework, the
   authors analyzed 500 articles from Web of Science (2010-2024) using
   VOSviewer. The methodology included tracking annual production,
   identifying prolific journals, analyzing countries, citing top articles
   and identifying hot topics in digitalization and entrepreneurial
   ecosystems.FindingsThe findings of this study highlight 2023 as the peak
   year for article production, with Zhang being the most productive
   author. The Sustainability (Switzerland) Journal leads in publications,
   China dominates contributions and ``digital transformation{''} emerges
   as a prominent keyword in research on digitalization in entrepreneurial
   ecosystems.Originality/valueThis study innovatively analyses how digital
   technologies and innovation transformed the entrepreneurial ecosystem,
   identifying trends and gaps for fostering sustainability in business
   practices.},
