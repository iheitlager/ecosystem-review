@article{ WOS:001504843500001,
Author = {Yin, Yongqiang and Gu, Jintu and Li, Mingchao},
Title = {How regional innovation ecology drives rural entrepreneurial vitality? a
   dynamic QCA analysis based on Chinese experience},
Journal = {TECHNOLOGY ANALYSIS \& STRATEGIC MANAGEMENT},
Year = {2025},
Month = {2025 JUN 7},
Abstract = {How to support entrepreneurship with innovation is a major issue in
   rural industrial revitalisation. This paper takes the 2012-2021 Chinese
   provincial panel data as a sample and explores the support path and its
   dynamic process with the help of the group perspective, the concept of
   innovation-driven entrepreneurship, and the theory of regional
   innovation ecosystem. It is found that innovation environment-cluster
   co-promotion, innovation cluster-strategy co-leadership and innovation
   environment-cluster-strategy synergistic promotion are the innovation
   groupings that generate high rural entrepreneurial vitality. Among them,
   innovation clusters under the market logic are irreplaceable for rural
   entrepreneurship, technology research and market application, green
   transformation and digital transformation are complementary, and a
   single green development constraint may become the only path to generate
   non-high entrepreneurial dynamics.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
