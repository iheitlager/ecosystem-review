@article{ WOS:001608752900001,
Author = {Ito, Hiroshi and Kato, Kazuhiko},
Title = {Biometric authentication as a platform strategy: the case of Tobu
   Railway's digital identity ecosystem},
Journal = {ASIAN JOURNAL OF TECHNOLOGY INNOVATION},
Year = {2025},
Month = {2025 NOV 4},
Abstract = {This study examines how Tobu Railway, one of Japan's major private
   railway companies, seeks to transform itself from a traditional
   transportation operator into a digital platform orchestrator through its
   Digital Identity Platform (DIPF) and SAKULaLa, a biometric
   authentication ecosystem co-developed with Hitachi. Using documentary
   analysis and focus group interviews with executives, the study employs
   reflexive-leaning hybrid thematic analysis to explore the strategic
   rationale, technological features, competitive advantages, and early
   adoption of the initiative. This study advances understanding of how
   legacy infrastructure firms govern digital identity ecosystems through
   layered interventions. The findings show that Tobu leverages biometric
   authentication not only as a technical solution but also as a governance
   mechanism, layering identity services across transportation, retail, and
   leisure. The study extends platform ecosystem theory beyond ICT firms
   into infrastructure-heavy industries, illustrating how layered
   interventions and domain redefinition enable incumbents to reposition
   themselves as orchestrators of multi-sector digital ecosystems. It also
   shows how private firms increasingly assume quasi-public functions by
   managing identity infrastructures, raising questions about legitimacy,
   accountability, and data governance. The study contributes to platform
   ecosystem theory and provides practical implications for innovation and
   regulatory oversight in the context of Japan's demographic decline and
