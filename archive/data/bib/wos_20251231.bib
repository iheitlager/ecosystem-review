@article{ WOS:000768633900005,
Author = {Browder, Russell E. and Koch, Hope and Long, Anna and Hernandez, James
   M.},
Title = {LEARNING TO INNOVATE WITH BIG DATA ANALYTICS IN INTERORGANIZATIONAL
   RELATIONSHIPS},
Journal = {ACADEMY OF MANAGEMENT DISCOVERIES},
Year = {2022},
Volume = {8},
Number = {1},
Pages = {139-166},
Month = {MAR},
Abstract = {Organizations must learn to innovate in new ways when pursuing digital
   transformation with ``big data analytics{''} (BDA). By analyzing an
   interorganizational relationship in which both vendor and client try to
   develop new products and services with BDA, this research examines the
   conditions under which BDA prompts organizations to explore novel
   innovation processes. Over the course of this longitudinal case study,
   the partners find that a service-dominant logic around capturing value
   no longer applies. Rather, the uncertainty of BDA innovation prompts a
   learning logic around creating value through collective experimentation.
   To explain these changes to the logic for innovation and
   interorganizational processes, we report four discoveries about the
   relationship between organizational learning under uncertainty,
   collective experimentation, and innovation trajectory shifts with BDA.
   This research provides a contextual understanding of creating value with
   BDA in interorganizational relationships and contributes to the
   literature on innovation and digital transformation with emerging
   technologies.},
