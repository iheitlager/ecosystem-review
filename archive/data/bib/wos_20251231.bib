@article{ WOS:000777585900001,
Author = {Rocha, Clarissa Figueredo and Quandt, Carlos Olavo and Deschamps,
   Fernando and Philbin, Simon},
Title = {R\&D collaboration strategies for industry 4.0 implementation: A case
   study in Brazil},
Journal = {JOURNAL OF ENGINEERING AND TECHNOLOGY MANAGEMENT},
Year = {2022},
Volume = {63},
Month = {JAN-MAR},
Abstract = {Companies need to collaborate with partners to co-create digital
   solutions as part of Industry 4.0 implementation. The objective of this
   study is to investigate how collaborative partnerships contribute to the
   digital transformation of organizations. The research design is based on
   a case study investigation of a Brazilian manufacturing company. The
   findings indicate that the company is already generating results through
   its commitment to open innovation practices. The results indicate that
   business success depends more on how disruptive technologies are
   developed and utilized by engaged people to add value, rather than
   focusing on the adoption of new technologies.},
