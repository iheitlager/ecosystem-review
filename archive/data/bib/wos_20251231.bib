@article{ WOS:000850882800003,
Author = {Li, Xianglong and Wang, Qingjin and Huang, Shuai and Shi, Renbo and Han,
   Changlin and Gao, Yang},
Title = {The Transfer Strategy of Digital Information Technology for
   Heterogeneous Manufacturers},
Journal = {JOURNAL OF ORGANIZATIONAL AND END USER COMPUTING},
Year = {2022},
Volume = {34},
Number = {8},
Abstract = {The application of digital information and computing technology can
   significantly improve cooperation between different enterprises and the
   efficiency of knowledge and resources management, while facilitating the
   participation of partners in various technological innovation
   activities. The choice of digital information technology by traditional
   enterprises and the transfer of digital information technology between
   enterprises are key issues in the application of industrial
   digitalisation at this stage, and it is necessary to explore their
   transfer strategies and operational mechanisms theoretically. In this
   paper, a digital information technology transfer system consisting of a
   high-tech enterprise and two heterogeneous manufacturing enterprises is
   simulated and constructed using the Stackelberg game approach. This
   system can help high-tech enterprises choose the optimal digital
   information technology transfer strategy, while promoting the digital
   transformation and upgrading development of traditional manufacturing
   enterprises.},
