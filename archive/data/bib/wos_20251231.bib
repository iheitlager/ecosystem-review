@article{ WOS:001339698600001,
Author = {Neuberger, Sabine and Paier, Manfred and Hoerlesberger, Marianne},
Title = {The effects of RRI-oriented roadmapping on the digital transformation of
   regions},
Journal = {JOURNAL OF RESPONSIBLE INNOVATION},
Year = {2024},
Volume = {11},
Number = {1},
Month = {DEC 31},
Abstract = {Responsible Research and Innovation (RRI) is a policy concept with the
   potential to support regional development and thus can guide the digital
   transformation of traditional industry regions. The DigiTeRRI project
   developed RRI-oriented roadmapping and applied it in three traditional
   industry regions in Austria, France, and Sweden. This research aimed to
   assess the effects of RRI-oriented roadmapping on advancing digital
   transformation in such traditional industry regions. Survey results
   showed that the digital maturity of organizations improved in the three
   pillars, i.e. Culture \& skills, Infrastructure \& technologies, and
   Ecosystem. Furthermore, the results indicate that RRI-oriented
   roadmapping had a positive effect in advancing the digital
   transformation of the three regions. This research adds to the
   literature on the RRI concept through the practical application of
   roadmapping to support the digital transformation of regions.},
