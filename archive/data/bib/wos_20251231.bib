ISSN = {0018-9391},
EISSN = {1558-0040},
Keywords = {Metaverse; Supply chains; Sustainable development; Project engineering;
   Collaboration; Companies; Behavioral sciences; Enterprise sustainable
   performance; metaverse; supply chain management (SCM); sustainable
   marketing; synergistic driving},
