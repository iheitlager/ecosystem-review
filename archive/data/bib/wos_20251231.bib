@article{ WOS:001499650200001,
Author = {Kim, Younggun and Heo, Ajung},
Title = {Search better, export stronger: the role of appropriability and digital
   strategy in South Korea},
Journal = {ASIAN JOURNAL OF TECHNOLOGY INNOVATION},
Year = {2025},
Month = {2025 MAY 29},
Abstract = {This study examines the impact of external knowledge search on export
   performance and explores the moderating effects of appropriability and
   digital transformation strategy in the context of South Korean firms.
   Based on the knowledge-based view, the research investigates how firms
   leverage external knowledge to enhance competitiveness and how
   protection mechanisms and digital strategies influence this
   relationship. Empirical analysis of 4000 firms shows that external
   knowledge search positively impacts export performance. While
   appropriability does not significantly affect this relationship, digital
   transformation strategy positively moderates the knowledge search-export
   performance link, highlighting the complementary effects of digital
   strategies in global competition.},
