@article{ WOS:001150799100001,
Author = {Du, Zhuo-Ya and Wang, Qian},
Title = {Unveiling the time-lag effects of digital transformation on financing
   constraints in Chinese listed enterprises: a study of automation and
   network technology},
Journal = {TECHNOLOGY ANALYSIS \& STRATEGIC MANAGEMENT},
Year = {2024},
Volume = {36},
Number = {12},
Pages = {4202-4216},
Month = {DEC 1},
Abstract = {Enterprise digital transformation is induced by automation and digital
   network technology, which have different time-lag effects on financing
   constraints. This study investigates the impact of two types of digital
   transformation on financing constraints among Chinese listed enterprises
   from 2007 to 2021. We find digital network technology increases
   financing constraints initially, but reduces them in the second lag
   periods. In contrast, automation reduces financing constraints in both
   the current period and the first lag period. The R\&D expense ratio
   plays a mediating role in the impact of the two types of digital
   transformation on financing constraints. State-owned enterprises (SOEs)
   experience no relief from financing constraints with the development of
   digital network technology but benefit from automation in reducing costs
   and increasing efficiency. Non-state-owned enterprises (Non-SOEs) shows
   empirical conclusions consistent with the full sample. This study
   highlights the different time-lag effects of the two types of digital
   transformation on financing constraints, which provides new insights
   into the impact of digital transformation on enterprises.},
