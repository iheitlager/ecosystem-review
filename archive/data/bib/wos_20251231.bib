@article{ WOS:001570269500001,
Author = {Rodriguez-Negron, Marcos Armando and Sosa-Varela, Juan Carlos and
   Santiago-Font, Zoe and Flecha-Ortiz, Jose A.},
Title = {Customer journey perspective on tourism service experience},
Journal = {ACADEMIA-REVISTA LATINOAMERICANA DE ADMINISTRACION},
Year = {2025},
Volume = {38},
Number = {4},
Pages = {600-625},
Month = {DEC 4},
Abstract = {PurposeThis study examines the role of experiencescape in shaping
   tourism service experiences from a customer journey perspective. It
   explores how the physical environment, service interactions and
   emotional engagement influence customer behavior across pre-visit, core
   and post-visit stages. Additionally, it investigates the mediating role
   of experiencescape in value co-creation and its impact on customer
   citizenship behavior and memorability.Design/methodology/approachA
   quantitative research design was employed, using a structured survey
   administered to 278 tourists in Puerto Rico. Data were collected through
   a five-point Likert scale measuring experiencescape, value co-creation,
   customer citizenship behavior and memorability. Partial least squares
   structural equation modeling (PLS-SEM) was applied to analyze the
   conceptual framework and assess direct and indirect relationships
   between variables.FindingsResults indicate that experiencescape
   significantly enhances value co-creation and directly influences
   customer engagement, satisfaction and memorability. Customer citizenship
   behavior reinforces positive post-visit experiences, strengthening
   destination loyalty and word-of-mouth recommendations. This study
   highlights the growing impact of digital transformation on modern travel
   behavior.Research limitations/implicationsThis study was limited to a
   single geographic context, which may affect the generalizability of the
   findings. Future research should explore experiencescape dynamics across
   diverse destinations and cultural settings.Practical
   implicationsFindings offer actionable insights for tourism marketers and
   service providers, emphasizing the integration of AI, digital platforms
   and personalized interactions to enhance customer satisfaction and
   engagement.Originality/valueThis study introduces a novel conceptual
   framework positioning experiencescape as a hybrid digital-physical
   ecosystem that shapes customer perceptions and engagement before, during
   and after travel, offering new insights into technology-driven tourism
   service design.
   Prop \& oacute;sitoEste estudio examina el papel del experiencescape en
   la configuraci \& oacute;n de las experiencias de servicio tur \&
   iacute;stico desde la perspectiva del recorrido del cliente. Explora c
   \& oacute;mo el entorno f \& iacute;sico, las interacciones en el
   servicio y la conexi \& oacute;n emocional influyen en el comportamiento
   del cliente en las etapas de pre-visita, n \& uacute;cleo y post-visita.
   Adem \& aacute;s, investiga el papel mediador del experiencescape en la
   co-creaci \& oacute;n de valor y su impacto en el comportamiento de
   ciudadan \& iacute;a del cliente y la memorabilidad.Dise \&
   ntilde;o/metodolog \& iacute;a/enfoqueSe emple \& oacute; un dise \&
   ntilde;o de investigaci \& oacute;n cuantitativo, utilizando una
   encuesta estructurada administrada a 278 turistas en Puerto Rico. Los
   datos se recopilaron mediante una escala Likert de cinco puntos para
   medir experiencescape, co-creaci \& oacute;n de valor, comportamiento de
   ciudadan \& iacute;a del cliente y memorabilidad. Se aplic \& oacute; el
   modelo de ecuaciones estructurales de m \& iacute;nimos cuadrados
   parciales (PLS-SEM) para analizar el marco conceptual y evaluar las
   relaciones directas e indirectas entre las variables.HallazgosLos
   resultados indican que el experiencescape mejora significativamente la
   co-creaci \& oacute;n de valor e influye directamente en el compromiso
   del cliente, la satisfacci \& oacute;n y la memorabilidad. El
   comportamiento de ciudadan \& iacute;a del cliente refuerza experiencias
   post-visita positivas, fortaleciendo la lealtad al destino y las
   recomendaciones boca a boca. El estudio destaca el creciente impacto de
   la transformaci \& oacute;n digital en el comportamiento moderno de los
   viajeros.Limitaciones de la investigaci \& oacute;nEste estudio se
   centra en un \& uacute;nico contexto geogr \& aacute;fico, lo que puede
   afectar la generalizaci \& oacute;n de los hallazgos. Se recomienda que
   futuras investigaciones exploren la din \& aacute;mica del
   experiencescape en destinos y contextos culturales
   diversos.Implicaciones pr \& aacute;cticasLos hallazgos ofrecen
   informaci \& oacute;n accionable para los especialistas en marketing tur
   \& iacute;stico y proveedores de servicios, enfatizando la integraci \&
   oacute;n de inteligencia artificial, plataformas digitales e
   interacciones personalizadas para mejorar la satisfacci \& oacute;n y el
   compromiso del cliente.Originalidad/valorEste estudio introduce un marco
   conceptual novedoso que posiciona el experiencescape como un ecosistema
   h \& iacute;brido digital-f \& iacute;sico que influye en la percepci \&
   oacute;n y el compromiso del cliente antes, durante y despu \& eacute;s
   del viaje, ofreciendo nuevas perspectivas sobre el dise \& ntilde;o de
   servicios tur \& iacute;sticos impulsados por la tecnolog \& iacute;a.},
