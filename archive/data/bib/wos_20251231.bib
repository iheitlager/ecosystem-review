@article{ WOS:000456221900010,
Author = {Subramaniam, Mohan and Iyer, Bala and Venkatraman, Venkat},
Title = {Competing in digital ecosystems},
Journal = {BUSINESS HORIZONS},
Year = {2019},
Volume = {62},
Number = {1},
Pages = {83-94},
Month = {JAN-FEB},
Abstract = {Digital technologies are revolutionizing traditional interdependencies
   among businesses. As a result, managers have begun to recognize their
   business environments as digital ecosystems. For firms accustomed to
   framing their business environments as industries, this represents a
   significant shift in perspective-one that requires an understanding of
   fresh strategic initiatives necessary to compete in the digital era. In
   this article, we highlight what is new and different about digital
   ecosystems for firm strategy. We offer frameworks that explain how
   digital ecosystems provide firms with new sources of value and new
   avenues for growth. Two sets of underlying concepts govern these
   frameworks: (1) production and consumption ecosystems and (2) digital
   envelopes and product-in-use information. We introduce and elaborate
   upon these foundational concepts and highlight new strategic options for
   firms to compete in digital ecosystems. (C) 2018 Kelley School of
   Business, Indiana University. Published by Elsevier Inc. All rights
   reserved.},
