@article{ WOS:001627485200001,
Author = {Lin, Qingxiu and Sun, Rui},
Title = {Digital innovation: theoretical framework and research outlook},
Journal = {TECHNOLOGY ANALYSIS \& STRATEGIC MANAGEMENT},
Year = {2025},
Month = {2025 NOV 28},
Abstract = {Despite growing attention to digital innovation, systematic bibliometric
   reviews of this field remain limitd. This study adopts bibliometric and
   visual mapping methods using VOSviewer and SciMAT to analyze 2169
   documents from the Scopus database. Research on digital innovation
   focuses on several clusters: digital technology, organisational
   transformation, innovation ecosystems, business model innovation, and
   industrial transformation and sustainable development. Since 2000, it
   has undergone approximately three development stages: exploration,
   differentiation, and deepening. Before 2014, digital innovation emerged
   with in information system but lacked a unique theoretical framework.
   During 2015-2017, research shifted from technology-oriented to
   innovation management-oriented perspectives, extending longitudinally
   (innovation process) and transversely (drivers and impacts). Since 2018,
   research topics have diversified considerably, reflecting deep
   theory-practice integration and multi-dimensional characteristics.
   Overall, current research presents a theoretical framework that
   interweaves micro, meso, and macro elements. However, digital innovation
   research remains in early deepening stages. Future studies shouled
   address the ternary coordination of people-digital technology-problem
   scenarios, emphasise sustainable digital innovation pathways, real
   impacts on value creation, governance mechanisms.},
