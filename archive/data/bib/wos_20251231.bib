@article{ WOS:001502499300035,
Author = {Achuthan, Krishnashree and Ramanathan, Sasangan and Raman, Raghu},
Title = {Exploring Metaverse Technologies in Entrepreneurship Through Machine
   Learning-Based Topic Modeling},
Journal = {IEEE ACCESS},
Year = {2025},
Volume = {13},
Pages = {93417-93438},
Abstract = {This study investigates the integration of metaverse technologies into
   entrepreneurship, focusing on policy frameworks, practical applications,
   research directions, and educational strategies to promote innovation
   and enhance business operations. Utilizing the preferred reporting items
   for systematic reviews and meta-analyses (PRISMA) framework, BERTopic
   modeling identified four key thematic areas in the literature: virtual
   reality (VR) in entrepreneurial education, augmented reality (AR) and VR
   in tourism, metaverse technologies for business ventures, and digital
   transformation. The main findings include that in education, VR enhances
   skills through immersive experiences, whereas AR and VR enrich tourism.
   Metaverse technologies create new business opportunities and redefine
   traditional models. Digital transformation, spurred by global events,
   drives innovation across various sectors. Case studies exploring the
   metaverse's benefits for entrepreneurship across industries, including
   NFTs and crypto ventures, healthcare, tourism, cultural engagement, and
   space exploration, are presented. These findings signify the potential
   of metaverse technologies in driving innovation and fostering
   entrepreneurial growth in education, tourism, business, and beyond.
   Additionally practical insights are offered into how immersive virtual
   technologies can transform entrepreneurial education and business models
   viewed from the lens of educators, policy makers, practitioners, and
   researchers while ensuring scalability and sustainability. A framework
   for future work in metaverse integration that touches on ethical
   standards, data privacy, and digital literacy to balance innovation with
   societal safeguards is presented.},
